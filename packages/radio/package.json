{
  "name": "@snailycad/radio",
  "version": "1.80.2",
  "typesVersions": {
    "*": {
      "browser": [
        "dist/browser/index.d.ts"
      ]
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "require": "./dist/browser/index.js",
      "import": "./dist/browser/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "scripts": {
    "build": "pnpm tsup",
    "watch": "pnpm tsup --watch --silent=false",
    "typecheck": "pnpm tsc --noEmit",
    "test": "pnpm vitest run"
  },
  "devDependencies": {
    "tsup": "6.6.2",
    "typescript": "^5.3.2",
    "vitest": "^0.34.6"
  },
  "tsup": {
    "entry": [
      "src/index.ts",
      "src/browser/index.ts"
    ],
    "dts": true,
    "bundle": true,
    "platform": "neutral",
    "target": "es2020",
    "splitting": true,
    "clean": true,
    "format": [
      "cjs",
      "esm"
    ],
    "external": [
      "livekit-client"
    ]
  },
  "dependencies": {
    "livekit-client": "2.5.10"
  }
}
